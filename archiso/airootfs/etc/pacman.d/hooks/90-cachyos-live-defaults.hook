# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = cachyos-kde-settings

[Action]
Description = Setting Ghostty as default terminal in KDE...
When = PostTransaction
Depends = kconfig
Exec = /bin/sh -c "kwriteconfig6 --file /etc/skel/.config/kdeglobals --group General --key TerminalApplication ghostty && kwriteconfig6 --file /etc/skel/.config/kdeglobals --group General --key TerminalService com.mitchellh.ghostty.desktop"
