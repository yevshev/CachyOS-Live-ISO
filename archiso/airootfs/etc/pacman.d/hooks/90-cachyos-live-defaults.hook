# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = cachyos-jay-noctalia

[Action]
Description = Customizing Jay + Noctalia live ISO defaults...
When = PostTransaction
Depends = bash
Depends = sed
Exec = /usr/bin/bash /etc/pacman.d/hooks/90-cachyos-live-defaults.sh
