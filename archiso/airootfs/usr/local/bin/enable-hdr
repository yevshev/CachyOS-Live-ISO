#!/usr/bin/env bash
set -euo pipefail

# Wait briefly for Jay DRM outputs to settle (especially over Thunderbolt)
json=""
for _ in 1 2 3 4 5; do
    json="$(jay --json randr show --formats 2>/dev/null || true)"
    if [[ -n "$json" ]] && jq -e '[.drm_devices[]?.connectors[]? | select(.enabled == true and .output != null)] | length > 0' <<< "$json" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

[[ -n "$json" ]] || exit 0

while IFS=$'\t' read -r name has_10bit; do
    [[ -n "$name" ]] || continue
    jay randr output "$name" colors set bt2020 pq || true
    if [[ "$has_10bit" == "true" ]]; then
        jay randr output "$name" format set xrgb2101010 || true
    fi
done < <(
    jq -r '
        .drm_devices[]?.connectors[]?
        | select(.enabled == true and .output != null)
        | select(
            ((.output.supported_color_spaces // []) | index("bt2020") != null)
            and ((.output.supported_eotfs // []) | index("pq") != null)
          )
        | [
            .name,
            (((.output.formats // []) | index("xrgb2101010") != null) | tostring)
          ]
        | @tsv
    ' <<< "$json"
)
